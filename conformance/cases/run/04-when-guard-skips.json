{
  "name": "run-when-guard-skips",
  "kind": "run",
  "description": "La garde when : le step saute avec le statut skipped et l'evenement step_skipped a la place de la paire started/finished. La regle de verite est celle d'Aetherius, pas celle du langage hote — false rend le step sautant, et les deux moteurs doivent sauter le meme.",
  "server": { "GET /todo": { "json": { "completed": false, "title": "delectus aut autem" } } },
  "blueprint": {
    "aetherius": "1.0",
    "name": "conformance.vector.when",
    "act": "vector",
    "inputs": { "base_url": { "type": "string", "required": true } },
    "steps": [
      {
        "id": "fetch",
        "action": "http.request",
        "method": "GET",
        "url": "{{ inputs.base_url }}/todo",
        "expect": { "status": 200 },
        "extract": {
          "title": { "from": "json", "path": "$.title" },
          "completed": { "from": "json", "path": "$.completed" }
        }
      },
      {
        "id": "alert_done",
        "action": "emit",
        "when": "{{ steps.fetch.completed | first }}",
        "message": "TODO_DONE"
      },
      {
        "id": "alert_pending",
        "action": "emit",
        "when": "{{ not steps.fetch.completed | first }}",
        "message": "TODO_PENDING"
      }
    ],
    "outputs": { "title": "{{ steps.fetch.title | first }}" }
  },
  "expect": {
    "python": {
      "outcome": "rendered",
      "value": {
        "status": "success",
        "outputs": { "title": "delectus aut autem" },
        "steps": [
          { "step_id": "fetch", "action": "http.request", "status": "success" },
          { "step_id": "alert_done", "action": "emit", "status": "skipped" },
          { "step_id": "alert_pending", "action": "emit", "status": "success" }
        ],
        "events": [
          { "type": "progress", "step_id": null },
          { "type": "step_started", "step_id": "fetch" },
          { "type": "step_finished", "step_id": "fetch" },
          { "type": "step_skipped", "step_id": "alert_done" },
          { "type": "step_started", "step_id": "alert_pending" },
          { "type": "progress", "step_id": "alert_pending" },
          { "type": "step_finished", "step_id": "alert_pending" },
          { "type": "done", "step_id": null }
        ]
      }
    },
    "embedded": {
      "outcome": "rendered",
      "value": {
        "status": "success",
        "outputs": { "title": "delectus aut autem" },
        "steps": [
          { "step_id": "fetch", "action": "http.request", "status": "success" },
          { "step_id": "alert_done", "action": "emit", "status": "skipped" },
          { "step_id": "alert_pending", "action": "emit", "status": "success" }
        ],
        "events": [
          { "type": "progress", "step_id": null },
          { "type": "step_started", "step_id": "fetch" },
          { "type": "step_finished", "step_id": "fetch" },
          { "type": "step_skipped", "step_id": "alert_done" },
          { "type": "step_started", "step_id": "alert_pending" },
          { "type": "progress", "step_id": "alert_pending" },
          { "type": "step_finished", "step_id": "alert_pending" },
          { "type": "done", "step_id": null }
        ]
      }
    }
  }
}
