# Service systemd utilisateur : le daemon Aetherius en continu sur une machine allumee, sans
# Docker (Raspberry Pi, machine perso). Recette complete : docs/deployment.md.
#
# Installation :
#   cp deploy/aetherius.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now aetherius
#   loginctl enable-linger $USER   # le service survit a la deconnexion de la session
#
# Journal : journalctl --user -u aetherius -f

[Unit]
Description=Aetherius daemon (scheduler + engine gateway)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Adapter au binaire reel : ~/.local/bin (pip install --user, pipx) ou le bin/ d'un venv.
ExecStart=%h/.local/bin/aetherius serve
Environment=AETHERIUS_DATA_DIR=%h/.aetherius
# Token et secrets (AETHERIUS_SECRET_*) : dans un fichier d'environnement non versionne,
# jamais en clair ici. Le tiret rend le fichier optionnel.
EnvironmentFile=-%h/.aetherius/daemon.env
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
