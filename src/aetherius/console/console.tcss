/* Aetherius Console stylesheet. Shared layout rules for every screen; widget-local rules that
   are meaningless outside their own widget live in that widget's DEFAULT_CSS instead. */

Screen {
    align: center top;
}

.console-title {
    text-style: bold;
    padding: 1 2 0 2;
}

.console-subtitle {
    color: $text-muted;
    padding: 0 2 1 2;
}

.console-body {
    width: 100%;
    height: 1fr;
    padding: 0 2;
}

.console-placeholder {
    width: 100%;
    height: 1fr;
    align: center middle;
    padding: 2 4;
}

.console-footer-hint {
    color: $text-muted;
    padding: 1 2;
}

.badge-available {
    color: $success;
    text-style: bold;
}

.badge-pending {
    color: $text-muted;
}

.form-field {
    padding: 0 0 1 0;
}

.form-field Label {
    padding: 0 0 0 0;
}

.run-actions {
    padding: 1 0;
    align: left middle;
}
