# Phase 1.5 - Jalon F (brouillon a finaliser ; voir docs/phase-1.5/f-deployment.md).
# Service systemd utilisateur pour faire tourner le daemon Aetherius en continu sur une machine
# allumee (sans Docker). Installer sous ~/.config/systemd/user/aetherius.service puis :
#   systemctl --user enable --now aetherius
#   loginctl enable-linger $USER   # pour que le service survive a la deconnexion

[Unit]
Description=Aetherius daemon (scheduler + engine gateway)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Adapter le chemin si aetherius n'est pas sur le PATH du service.
ExecStart=%h/.local/bin/aetherius serve
Environment=AETHERIUS_DATA_DIR=%h/.aetherius
# Secrets et token : preferer un EnvironmentFile non versionne plutot que des valeurs en clair ici.
# EnvironmentFile=%h/.aetherius/daemon.env
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
