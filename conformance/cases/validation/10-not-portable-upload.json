{
  "name": "not-portable-upload",
  "description": "Divergence assumee : 'upload' est valide pour continuum, mais une WebView n'expose pas de file chooser. Le Blueprint est correct, il appartient au moteur Python.",
  "blueprint": {
    "aetherius": "1.0",
    "name": "conformance.portable.upload",
    "act": "continuum",
    "steps": [
      { "action": "navigate", "url": "https://example.test" },
      { "id": "send", "action": "upload", "selector": "input[type=file]", "file": "/tmp/a.png" }
    ]
  },
  "expect": {
    "python": { "outcome": "accepted" },
    "embedded": {
      "outcome": "rejected",
      "error": "BlueprintValidationError",
      "message_contains": ["'upload'", "act='continuum'", "not by the embedded engine", "file chooser"]
    }
  }
}
