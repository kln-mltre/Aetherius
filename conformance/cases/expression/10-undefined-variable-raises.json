{
  "name": "expr-undefined-variable",
  "kind": "expression",
  "description": "StrictUndefined : une variable absente leve, elle ne rend pas une chaine vide. C'est ce qui transforme une faute de frappe en erreur immediate.",
  "context": {
    "steps": {
      "x": {}
    }
