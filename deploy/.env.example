# Environnement du daemon deploye — docker compose lit ce fichier via env_file.
# Copier vers .env (jamais versionne) puis renseigner ce qui est utile :
#   cp .env.example .env

# Token bearer exige sur /v1/* des qu'il est defini (vide ou absent = auth desactivee, usage
# loopback). OBLIGATOIRE avant d'exposer le port hors de l'hote — et toujours derriere un
# reverse proxy TLS (voir docs/deployment.md, section Securite).
#AETHERIUS_DAEMON_TOKEN=

# Secrets des Blueprints (voir docs/secrets.md) : AETHERIUS_SECRET_<NOM_EN_MAJUSCULES>.
# Exemple pour un Blueprint declarant "secrets": ["cas_user", "cas_pass"] :
#AETHERIUS_SECRET_CAS_USER=
#AETHERIUS_SECRET_CAS_PASS=

# Fuseau horaire du conteneur : les expressions cron des schedules s'evaluent en heure locale
# (docs/scheduler.md). Sans TZ, le conteneur vit en UTC.
#TZ=Europe/Paris
