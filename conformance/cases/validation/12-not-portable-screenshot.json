{
  "name": "not-portable-screenshot",
  "description": "Divergence assumee : capturer la WebView releve de l'application hote, pas du moteur.",
  "blueprint": {
    "aetherius": "1.0",
    "name": "conformance.portable.screenshot",
    "act": "continuum",
    "steps": [{ "id": "shot", "action": "screenshot", "path": "out.png" }]
  },
  "expect": {
    "python": { "outcome": "accepted" },
    "embedded": {
      "outcome": "rejected",
      "error": "BlueprintValidationError",
      "message_contains": ["'screenshot'", "not by the embedded engine"]
    }
  }
}
