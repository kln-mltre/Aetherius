{
  "aetherius": "1.0",
  "name": "quotes.scrape.stealth",
  "description": "Act II (Continuum) avec la couche de discretion activee : fingerprint chrome-desktop, souris a gestes rejoues, frappe humaine et scroll adouci. Scrape quotes.toscrape.com en se comportant comme un humain (clic sur la pagination via un vrai geste souris). Zero config, executable tel quel depuis 'aetherius run' ou la Console.",
  "act": "continuum",
  "vars": { "domain": "https://quotes.toscrape.com" },
  "options": {
    "debug": true,
    "timeout_ms": 20000,
    "stealth": {
      "mouse": "gestures",
      "keyboard": "human",
      "scroll": "eased",
      "timing": { "distraction": 0.1 },
      "fingerprint": "chrome-desktop"
    }
  },
  "steps": [
    { "id": "home", "action": "navigate", "url": "{{ vars.domain }}/" },
    {
      "id": "page1",
      "action": "extract",
      "outputs": {
        "citation": { "selector": ".quote .text", "as": "text" },
        "auteur": { "selector": ".quote .author", "as": "text" }
      }
    },
    { "action": "scroll", "dy": 600 },
    { "action": "click", "selector": "li.next a" },
    { "action": "wait_for", "selector": ".quote", "timeout_ms": 15000 },
    {
      "id": "page2",
      "action": "extract",
      "outputs": {
        "citation": { "selector": ".quote .text", "as": "text" },
        "auteur": { "selector": ".quote .author", "as": "text" }
      }
    }
  ],
  "outputs": {
    "page1_citation": "{{ steps.page1.citation }}",
    "page1_auteur": "{{ steps.page1.auteur }}",
    "page2_citation": "{{ steps.page2.citation }}",
    "page2_auteur": "{{ steps.page2.auteur }}"
  }
}
